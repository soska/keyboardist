{
  "name": "keyboardist",
  "version": "2.0.2",
  "description": "A declarative way to add keyboard shortcuts to your browser applications",
  "author": "Armando Sosa <arm.sosa@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "keyboard",
    "shortcuts",
    "hotkeys",
    "keybindings"
  ],
  "homepage": "https://github.com/soska/keyboardist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soska/keyboardist.git",
    "directory": "packages/keyboardist"
  },
  "bugs": "https://github.com/soska/keyboardist/issues",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:publish": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.1",
    "happy-dom": "^20.11.1",
    "publint": "^0.3.21",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
