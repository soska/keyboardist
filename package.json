{
  "name": "keyboardist-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --filter @keyboardist/website dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm exec biome ci . && pnpm -r typecheck && pnpm -r test && pnpm -r build && pnpm --filter keyboardist check:publish",
    "changeset": "changeset",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^2.31.1",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1"
    }
  }
}
